{
  "name": "redmine-companion",
  "productName": "Redmine Companion",
  "version": "1.1.0-beta2",
  "description": "Desktop companion for Redmine",
  "main": "src/main/main.js",
  "author": "Community",
  "license": "MIT",
  "homepage": "https://github.com/",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "portable": "electron-builder --win portable"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "dayjs": "^1.11.13",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.redmine.notifier",
    "productName": "Redmine Notifier",
    "artifactName": "${productName}-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Redmine Companion"
    }
  }
}